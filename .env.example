# No environment variables or API credentials are required by this application.
# This file documents the current configuration; there is no .env loader.
# API: 127.0.0.1:3001 (server/src/index.ts)
# Vite: localhost:5173; /api proxy targets localhost:3001 (client/vite.config.ts)
# SQLite: server/data/building.db (created automatically)
# Uploads: server/data/uploads/ (created automatically)
# Never put credentials in VITE_* variables: they are exposed to the browser.
